PORT=4000
NODE_ENV=development
GITHUB_TOKEN=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
SARVAM_API_KEY=
SARVAM_MODEL=
SERPAPI_API_KEY=
CLIENT_ORIGIN=http://localhost:5173

LLM_FALLBACK_MODEL=

# Production requires an HTTPS origin. Public exploration has no shared password.
PUBLIC_ORIGIN=
# Enable only when the API is isolated behind your trusted TLS proxy.
TRUST_PROXY=0
# Defaults to the project's ignored .whycode directory.
DATA_DIRECTORY=
# Optional encrypted login persistence on a single server; use a stable random
# 32-byte base64 key stored separately from DATA_DIRECTORY. Never expose it to the web app.
SESSION_ENCRYPTION_KEY=
# Optional shared rate limits. Both values are required to enable this mode.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_NAMESPACE=whycode-development
# Shared daily answer budget; requires the runtime answer-budget SQL migration.
DATABASE_URL=
DATABASE_SSL_CA_FILE=
DAILY_ANSWER_LIMIT=100
DOMAIN=

# Optional managed accounts (server-side only; never use a service-role key here).
SUPABASE_URL=
SUPABASE_ANON_KEY=
ACCOUNT_PROVIDERS=email,google,github
# A GitHub App with Contents, Pull requests, Issues and Metadata READ access only.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
